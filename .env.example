# Copy to .env.local for local use, or set these on your host.
# Do NOT commit a filled-in copy of this file.

# ---------------------------------------------------------------------------
# Database (required)
# ---------------------------------------------------------------------------
# Your MongoDB connection string. A free Atlas M0 cluster is enough — this app
# stores everything in one document, well under the free 512 MB.
# Get it from Atlas: Connect → Drivers → copy the srv string, then replace
# <password> with your database user's password.
MONGODB_URI=mongodb+srv://user:password@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority

# Optional. Which database inside the cluster to use. Defaults to "my-finance".
# Handy for pointing local development at a separate database on the same
# cluster so you do not experiment on your real records.
# MONGODB_DB=my-finance

# ---------------------------------------------------------------------------
# Password gate
# ---------------------------------------------------------------------------
# Required for any deployment. Without it, a production build refuses to serve
# anything at all rather than publishing your finances to whoever finds the URL.
# Use something long; you only type it once per device per month.
FINANCE_PASSWORD=

# Optional. Sessions are signed with a key derived from FINANCE_PASSWORD, so
# changing the password signs you out everywhere. Set this to keep sessions
# alive across a password change.
# FINANCE_SESSION_SECRET=

# Escape hatch for running a production build on your own machine with no
# password. Never set this on a host that is reachable from the internet.
# FINANCE_ALLOW_NO_PASSWORD=true


